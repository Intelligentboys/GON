import torch
import torch.nn as nn
import matplotlib.pyplot as plt

# -------------------- 参数 --------------------
n = 32
eps = 0.3
K_iter = 5
num_train = 5000
num_test = 50
epochs_init = 150
epochs_per_step = 75
lr = 1e-3
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# -------------------- 数据生成 --------------------
def generate_data(num_samples):
    c = torch.rand(num_samples, n, device=device) * 2 - 1
    u = torch.zeros_like(c)
    for _ in range(200):
        u_next = c + eps * torch.sin(torch.cat([u[:, 1:], u[:, :1]], dim=1))
        u = u_next
    return c, u

torch.manual_seed(42)
c_train, u_train = generate_data(num_train)
c_test, u_test = generate_data(num_test)

# -------------------- 基础函数 --------------------
def shift(u):
    return torch.cat([u[:, 1:], u[:, :1]], dim=1)

def compute_residual(c, u):
    return u - c - eps * torch.sin(shift(u))

# ==================== 迭代器类 ====================
# 1. 固定不动点（无参数）
class FixedPointIterator(nn.Module):
    def __init__(self):
        super().__init__()
        self.register_buffer('eps', torch.tensor(eps, device=device))

    def forward(self, c, u):
        G = c + self.eps * torch.sin(shift(u))
        return G  # alpha=1

# 2. 参数化不动点（可训练 eps_param）
class ParamFixedPointIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.eps_param = nn.Parameter(torch.full((n,), eps, device=device))
        else:
            self.register_buffer('eps_param', torch.full((n,), eps, device=device))

    def forward(self, c, u):
        eps_i = self.eps_param.unsqueeze(0)
        return c + eps_i * torch.sin(shift(u))

# 3. 固定解析牛顿（无参数）
class AnalyticNewtonIterator(nn.Module):
    def __init__(self):
        super().__init__()
        self.register_buffer('eps', torch.tensor(eps, device=device))

    def forward(self, c, u):
        batch = u.size(0)
        F = compute_residual(c, u)
        J = torch.zeros(batch, n, n, device=device)
        for i in range(n):
            J[:, i, i] = 1.0
            j = (i + 1) % n
            J[:, i, j] = -self.eps * torch.cos(u[:, j])
        delta = torch.linalg.solve(J, -F.unsqueeze(-1)).squeeze(-1)
        return u + delta

# 4. 参数化牛顿（可训练 diag, offdiag）
class ParamNewtonIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.diag = nn.Parameter(torch.ones(n, device=device))
            self.offdiag = nn.Parameter(torch.full((n,), -eps, device=device))
        else:
            self.register_buffer('diag', torch.ones(n, device=device))
            self.register_buffer('offdiag', torch.full((n,), -eps, device=device))

    def forward(self, c, u):
        batch = u.size(0)
        F = compute_residual(c, u)
        J = torch.zeros(batch, n, n, device=device)
        for i in range(n):
            J[:, i, i] = self.diag[i]
            j = (i + 1) % n
            J[:, i, j] = self.offdiag[i] * torch.cos(u[:, j])
        delta = torch.linalg.solve(J, -F.unsqueeze(-1)).squeeze(-1)
        return u + delta

# 5. 固定离散牛顿（无参数）
# 已删除，改为使用纯展开的对角割线法（见第 6 部分）

# 6. 对角割线法（可训练 inv_diag, rho）
class DiagonalSecantIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.inv_diag = nn.Parameter(torch.ones(n, device=device))
            self.rho = nn.Parameter(torch.tensor(1.0, device=device))
        else:
            self.register_buffer('inv_diag', torch.ones(n, device=device))
            self.register_buffer('rho', torch.tensor(1.0, device=device))

    def forward(self, c, u):
        F = compute_residual(c, u)
        delta = self.inv_diag * F
        return u - self.rho * delta

# ==================== GON模型与工具 ====================
class GONModel(nn.Module):
    def __init__(self, initial_net, iterators):
        super().__init__()
        self.initial = initial_net
        self.iterators = nn.ModuleList(iterators)

    def forward(self, c):
        u = self.initial(c)
        for it in self.iterators:
            u = it(c, u)
        return u

def train_model(model, epochs, lr=1e-3):
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    best_loss = float('inf')
    best_state = None
    for ep in range(epochs):
        optimizer.zero_grad()
        pred = model(c_train)
        loss = torch.mean((pred - u_train) ** 2)
        loss.backward()
        optimizer.step()
        with torch.no_grad():
            test_loss = torch.mean((model(c_test) - u_test) ** 2)
            if test_loss < best_loss:
                best_loss = test_loss
                best_state = {k: v.clone() for k, v in model.state_dict().items()}
    if best_state is not None:
        model.load_state_dict(best_state)
    return model

def evaluate(model):
    with torch.no_grad():
        pred = model(c_test)
        return (torch.mean((pred - u_test) ** 2) / torch.mean(u_test ** 2)).item()

def count_all_params(model):
    return sum(p.numel() for p in model.state_dict().values())

# -------------------- 运行实验 --------------------
def run_experiment(iterator_class, method_name, is_param=False):
    """
    非参数化 (is_param=False)：直接逐层展开，不训练，收集每层误差。
    参数化 (is_param=True)：逐层展开，每添加一层后训练整个网络，收集训练后的误差。
    返回 params_list, errors_list
    """
    print(f"\n===== Running {method_name} =====")
    # 初始网络（需要训练）
    initial_net = nn.Linear(n, n, bias=True).to(device)
    initial_net = train_model(initial_net, epochs=epochs_init)

    if not is_param:
        # 非参数化：纯展开
        iterators = [iterator_class() for _ in range(K_iter)]
        params, errors = [], []
        for step in range(K_iter + 1):
            model = GONModel(initial_net, iterators[:step]).to(device)
            err = evaluate(model)
            p = count_all_params(model)
            params.append(p)
            errors.append(err)
            print(f"  step {step:2d}: params={p:6d}, error={err:.3e}")
        return params, errors
    else:
        # 参数化：逐层展开+训练
        trainable_iters = []
        model = GONModel(initial_net, trainable_iters).to(device)
        params, errors = [], []
        for step in range(K_iter + 1):
            if step == 0:
                err = evaluate(model)
                p = count_all_params(model)
            else:
                new_it = iterator_class(trainable=True)
                trainable_iters.append(new_it)
                model = GONModel(initial_net, trainable_iters).to(device)
                model = train_model(model, epochs=epochs_per_step)
                err = evaluate(model)
                p = count_all_params(model)
            params.append(p)
            errors.append(err)
            print(f"  step {step:2d}: params={p:6d}, error={err:.3e}")
        return params, errors

# ==================== 定义所有方法 ====================
methods = [
    ("FixedPoint", FixedPointIterator, False),
    ("ParamFixedPoint", ParamFixedPointIterator, True),
    ("AnalyticNewton", AnalyticNewtonIterator, False),
    ("ParamNewton", ParamNewtonIterator, True),
    ("DiagonalSecantPure", DiagonalSecantIterator, False),
    ("DiagonalSecant", DiagonalSecantIterator, True),
]

all_results = {}
for name, cls, is_param in methods:
    params, errors = run_experiment(cls, name, is_param)
    all_results[name] = (params, errors)

# 按方法类别分别取参考横坐标：
# 1) 不动点类：FixedPoint / ParamFixedPoint
# 2) 牛顿类：AnalyticNewton / ParamNewton
# 3) 割线类：DiagonalSecantPure / DiagonalSecant
reference_params = {
    "FixedPoint": None,
    "ParamFixedPoint": None,
    "AnalyticNewton": None,
    "ParamNewton": None,
    "DiagonalSecantPure": None,
    "DiagonalSecant": None,
}

for name in reference_params.keys():
    if name in all_results:
        reference_params[name] = all_results[name][0]

# ==================== 绘图（6条线） ====================
plt.figure(figsize=(12, 8))
markers = ['o', 's', '^', 'D', 'v', 'p']
colors = ['blue', 'cyan', 'red', 'magenta', 'green', 'orange']
for i, (name, (params, errors)) in enumerate(all_results.items()):
    if name in ["FixedPoint", "ParamFixedPoint"]:
        x_vals = reference_params["ParamFixedPoint"]
    elif name in ["AnalyticNewton", "ParamNewton"]:
        x_vals = reference_params["ParamNewton"]
    elif name in ["DiagonalSecantPure", "DiagonalSecant"]:
        x_vals = reference_params["DiagonalSecant"]
    else:
        x_vals = params

    plt.semilogy(x_vals, errors, marker=markers[i], linestyle='-', color=colors[i],
                 label=name, linewidth=2)

plt.xlabel('Total Parameters', fontsize=12)
plt.ylabel('Relative Test MSE', fontsize=12)
plt.grid(True, which='both', linestyle='--', alpha=0.6)
plt.legend(fontsize=10, ncol=2)
plt.tight_layout()
plt.savefig('gon_six_curves_correct.png', dpi=300)
plt.show()
print("Done. Plot saved as 'gon_six_curves_correct.png'")
