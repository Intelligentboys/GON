import torch
import torch.nn as nn
import matplotlib.pyplot as plt
import time

# -------------------- 参数 --------------------
n = 32
eps = 0.3
K_iter = 5
num_train = 5000
num_test = 50
epochs_init = 150
epochs_per_step = 75
lr = 1e-3
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# -------------------- 数据生成 --------------------
def generate_data(num_samples):
    c = torch.rand(num_samples, n, device=device) * 2 - 1
    u = torch.zeros_like(c)
    for _ in range(200):
        u_next = c + eps * torch.sin(torch.cat([u[:, 1:], u[:, :1]], dim=1))
        u = u_next
    return c, u

torch.manual_seed(42)
c_train, u_train = generate_data(num_train)
c_test, u_test = generate_data(num_test)

# -------------------- 基础函数 --------------------
def shift(u):
    return torch.cat([u[:, 1:], u[:, :1]], dim=1)

def compute_residual(c, u):
    return u - c - eps * torch.sin(shift(u))

# ==================== 迭代器类 ====================
class FixedPointIterator(nn.Module):
    def __init__(self):
        super().__init__()
        self.register_buffer('eps', torch.tensor(eps, device=device))

    def forward(self, c, u):
        G = c + self.eps * torch.sin(shift(u))
        return G

class ParamFixedPointIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.eps_param = nn.Parameter(torch.full((n,), eps, device=device))
        else:
            self.register_buffer('eps_param', torch.full((n,), eps, device=device))

    def forward(self, c, u):
        eps_i = self.eps_param.unsqueeze(0)
        return c + eps_i * torch.sin(shift(u))

class AnalyticNewtonIterator(nn.Module):
    def __init__(self):
        super().__init__()
        self.register_buffer('eps', torch.tensor(eps, device=device))

    def forward(self, c, u):
        batch = u.size(0)
        F = compute_residual(c, u)
        J = torch.zeros(batch, n, n, device=device)
        for i in range(n):
            J[:, i, i] = 1.0
            j = (i + 1) % n
            J[:, i, j] = -self.eps * torch.cos(u[:, j])
        delta = torch.linalg.solve(J, -F.unsqueeze(-1)).squeeze(-1)
        return u + delta

class ParamNewtonIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.diag = nn.Parameter(torch.ones(n, device=device))
            self.offdiag = nn.Parameter(torch.full((n,), -eps, device=device))
        else:
            self.register_buffer('diag', torch.ones(n, device=device))
            self.register_buffer('offdiag', torch.full((n,), -eps, device=device))

    def forward(self, c, u):
        batch = u.size(0)
        F = compute_residual(c, u)
        J = torch.zeros(batch, n, n, device=device)
        for i in range(n):
            J[:, i, i] = self.diag[i]
            j = (i + 1) % n
            J[:, i, j] = self.offdiag[i] * torch.cos(u[:, j])
        delta = torch.linalg.solve(J, -F.unsqueeze(-1)).squeeze(-1)
        return u + delta

class DiagonalSecantIterator(nn.Module):
    def __init__(self, trainable=False):
        super().__init__()
        if trainable:
            self.inv_diag = nn.Parameter(torch.ones(n, device=device))
            self.rho = nn.Parameter(torch.tensor(1.0, device=device))
        else:
            self.register_buffer('inv_diag', torch.ones(n, device=device))
            self.register_buffer('rho', torch.tensor(1.0, device=device))

    def forward(self, c, u):
        F = compute_residual(c, u)
        delta = self.inv_diag * F
        return u - self.rho * delta

# ==================== GON模型与工具 ====================
class GONModel(nn.Module):
    def __init__(self, initial_net, iterators):
        super().__init__()
        self.initial = initial_net
        self.iterators = nn.ModuleList(iterators)

    def forward(self, c):
        u = self.initial(c)
        for it in self.iterators:
            u = it(c, u)
        return u

def train_model(model, epochs, lr=1e-3):
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    best_loss = float('inf')
    best_state = None
    for ep in range(epochs):
        optimizer.zero_grad()
        pred = model(c_train)
        loss = torch.mean((pred - u_train) ** 2)
        loss.backward()
        optimizer.step()
        with torch.no_grad():
            test_loss = torch.mean((model(c_test) - u_test) ** 2)
            if test_loss < best_loss:
                best_loss = test_loss
                best_state = {k: v.clone() for k, v in model.state_dict().items()}
    if best_state is not None:
        model.load_state_dict(best_state)
    return model

def evaluate(model):
    model.eval()
    if torch.cuda.is_available():
        torch.cuda.synchronize()
    start = time.perf_counter()
    with torch.no_grad():
        pred = model(c_test)
        rel_error = (torch.mean((pred - u_test) ** 2) / torch.mean(u_test ** 2)).item()
    if torch.cuda.is_available():
        torch.cuda.synchronize()
    end = time.perf_counter()
    return rel_error, end - start

def count_all_params(model):
    return sum(p.numel() for p in model.state_dict().values())

# ==================== Baseline 模型（多层全连接 + ReLU） ====================
class BaselineNet(nn.Module):
    def __init__(self, dim, num_extra=0):
        super().__init__()
        self.initial = nn.Linear(dim, dim, bias=True)
        self.extra = nn.ModuleList()
        for _ in range(num_extra):
            self.extra.append(nn.Sequential(
                nn.Linear(dim, dim, bias=True),
                nn.ReLU()
            ))

    def forward(self, x):
        out = self.initial(x)
        for layer in self.extra:
            out = layer(out)
        return out

# -------------------- 运行实验（原有方法） --------------------
def run_experiment(iterator_class, method_name, is_param=False):
    print(f"\n===== Running {method_name} =====")
    initial_net = nn.Linear(n, n, bias=True).to(device)
    initial_net = train_model(initial_net, epochs=epochs_init)

    if not is_param:
        iterators = [iterator_class() for _ in range(K_iter)]
        params, errors, times = [], [], []
        for step in range(K_iter + 1):
            model = GONModel(initial_net, iterators[:step]).to(device)
            err, elapsed = evaluate(model)
            p = count_all_params(model)
            params.append(p)
            errors.append(err)
            times.append(elapsed)
            print(f"  step {step:2d}: params={p:6d}, error={err:.3e}, time={elapsed:.4f}s")
        return params, errors, times, None
    else:
        trainable_iters = []
        model = GONModel(initial_net, trainable_iters).to(device)
        params, errors, times = [], [], []
        initial_param_values = []
        for step in range(K_iter + 1):
            if step == 0:
                err, elapsed = evaluate(model)
                p = count_all_params(model)
                params.append(p)
                errors.append(err)
                times.append(elapsed)
                print(f"  step {step:2d}: params={p:6d}, error={err:.3e}, time={elapsed:.4f}s")
            else:
                new_it = iterator_class(trainable=True)
                for name, param in new_it.named_parameters():
                    initial_param_values.append((name, param.data.clone()))
                trainable_iters.append(new_it)
                model = GONModel(initial_net, trainable_iters).to(device)
                model = train_model(model, epochs=epochs_per_step)
                err, elapsed = evaluate(model)
                p = count_all_params(model)
                params.append(p)
                errors.append(err)
                times.append(elapsed)
                print(f"  step {step:2d}: params={p:6d}, error={err:.3e}, time={elapsed:.4f}s")

        all_diffs = []
        for name, init_val in initial_param_values:
            found = False
            for it in model.iterators:
                if hasattr(it, name):
                    curr = getattr(it, name)
                    if curr is not None and curr.requires_grad:
                        diff = torch.max(torch.abs(curr.data - init_val)).item()
                        all_diffs.append(diff)
                        found = True
                        break
            if not found:
                print(f"Warning: parameter '{name}' not found in final model")
        if all_diffs:
            max_diff = max(all_diffs)
            mean_diff = sum(all_diffs) / len(all_diffs)
            print(f"  Parameter change (inf norm) for {method_name}: max={max_diff:.3e}, mean={mean_diff:.3e}")
        else:
            max_diff = 0.0
            mean_diff = 0.0
        diff_info = {'max': max_diff, 'mean': mean_diff, 'all': all_diffs}
        return params, errors, times, diff_info

# ==================== 运行所有已有方法 ====================
methods = [
    ("FixedPoint", FixedPointIterator, False),
    ("ParamFixedPoint", ParamFixedPointIterator, True),
    ("AnalyticNewton", AnalyticNewtonIterator, False),
    ("ParamNewton", ParamNewtonIterator, True),
    ("DiagonalSecantPure", DiagonalSecantIterator, False),
    ("DiagonalSecant", DiagonalSecantIterator, True),
]

all_results = {}
for name, cls, is_param in methods:
    params, errors, times, diff = run_experiment(cls, name, is_param)
    all_results[name] = (params, errors, times, diff)

# ==================== 运行 Baseline 模型 ====================
print("\n===== Running Baseline =====")
baseline_model = BaselineNet(n, num_extra=0).to(device)
baseline_model = train_model(baseline_model, epochs=epochs_init)

baseline_params = []
baseline_errors = []
baseline_times = []
current_extra = 0

for step in range(K_iter + 1):
    target_extra = step  # 每增加一个迭代器，baseline 增加一层
    if target_extra > current_extra:
        for _ in range(target_extra - current_extra):
            new_layer = nn.Sequential(
                nn.Linear(n, n, bias=True),
                nn.ReLU()
            ).to(device)
            baseline_model.extra.append(new_layer)
        baseline_model = train_model(baseline_model, epochs=epochs_per_step)
        current_extra = target_extra
    err, elapsed = evaluate(baseline_model)
    p = count_all_params(baseline_model)
    baseline_params.append(p)
    baseline_errors.append(err)
    baseline_times.append(elapsed)
    print(f"  step {step:2d}: params={p:6d}, error={err:.3e}, time={elapsed:.4f}s")

# 将 baseline 加入结果字典（方便绘图）
all_results["Baseline"] = (baseline_params, baseline_errors, baseline_times, None)

# 打印参数变化摘要
print("\n===== Parameter Change Summary (for trainable models) =====")
for name, (_, _, _, diff) in all_results.items():
    if diff is not None:
        print(f"{name:20s}: max inf-norm diff = {diff['max']:.3e}, mean = {diff['mean']:.3e}")

# ==================== 绘图（7条曲线） ====================
reference_params = {
    "FixedPoint": None,
    "ParamFixedPoint": None,
    "AnalyticNewton": None,
    "ParamNewton": None,
    "DiagonalSecantPure": None,
    "DiagonalSecant": None,
    "Baseline": None,
}

for name in reference_params.keys():
    if name in all_results:
        reference_params[name] = all_results[name][0]

plt.figure(figsize=(12, 8))
markers = ['o', 's', '^', 'D', 'v', 'p', '*']
colors = ['blue', 'cyan', 'red', 'magenta', 'green', 'orange', 'purple']
for i, (name, (params, errors, times, diff)) in enumerate(all_results.items()):
    if name in ["FixedPoint", "ParamFixedPoint"]:
        x_vals = reference_params["ParamFixedPoint"]
    elif name in ["AnalyticNewton", "ParamNewton"]:
        x_vals = reference_params["ParamNewton"]
    elif name in ["DiagonalSecantPure", "DiagonalSecant"]:
        x_vals = reference_params["DiagonalSecant"]
    else:
        x_vals = params  # Baseline 直接用自己的 params

    plt.semilogy(x_vals, errors, marker=markers[i], linestyle='-', color=colors[i],
                 label=name, linewidth=2)

plt.xlabel('Total Parameters', fontsize=12)
plt.ylabel('Relative Test MSE', fontsize=12)
plt.grid(True, which='both', linestyle='--', alpha=0.6)
plt.legend(fontsize=10, ncol=2)
plt.tight_layout()
plt.savefig('gon_six_curves_correct.png', dpi=300)
plt.show()
print("Done. Plot saved as 'gon_six_curves_correct.png'")
